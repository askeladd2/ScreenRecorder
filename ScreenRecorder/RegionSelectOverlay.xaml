<Window x:Class="ScreenRecorder.RegionSelectOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#55000000"
        Topmost="True"
        WindowState="Maximized"
        Cursor="Cross"
        KeyDown="Window_KeyDown">

    <Canvas x:Name="OverlayCanvas" MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
            MouseMove="Canvas_MouseMove">

        <!-- Instruction Text -->
        <Border Canvas.Left="50%" Canvas.Top="40"
                Background="#CC000000" CornerRadius="8" Padding="12,8"
                x:Name="InstructionBorder">
            <TextBlock Text="Drag to select recording area • Press ESC to cancel"
                       Foreground="White" FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <!-- Selection Rectangle -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#00E5FF"
                   StrokeThickness="2"
                   Fill="#2200E5FF"
                   Visibility="Hidden"/>

        <!-- Dimension Label -->
        <Border x:Name="DimLabel" Background="#CC000000" CornerRadius="4" Padding="6,3" Visibility="Hidden">
            <TextBlock x:Name="DimText" Foreground="#00E5FF" FontSize="11" FontFamily="Consolas"/>
        </Border>

    </Canvas>
</Window>
